# Generate independent random URL-safe passwords (at least 24 characters).
POSTGRES_ADMIN_PASSWORD=replace_with_random_admin_password
MESH_DB_PASSWORD=replace_with_random_runtime_password
DATABASE_URL=postgresql+psycopg://mesh_runtime:replace_with_random_runtime_password@localhost:5432/mesh
SUPABASE_URL=
SUPABASE_ANON_KEY=
JWT_AUDIENCE=authenticated
REDIS_URL=redis://localhost:6379/0
# Independent random secret (at least 32 characters) for private per-account rate-limit keys.
AUTH_RATE_SECRET=
CORS_ORIGINS=["http://localhost:3000"]
ENVIRONMENT=development
TEST_MODE=false
SMTP_HOST=
SMTP_PORT=1025
SMTP_FROM=mesh@localhost
# Fixed endpoint without credentials, query or fragment. Production SMTP requires HTTPS.
INVITATION_BASE_URL=http://localhost:3000/invitations/accept
WORKER_ORGANIZATION_ID=
# Generate with cryptography.fernet.Fernet.generate_key(); never commit the real key.
MAIL_ENCRYPTION_KEY=
SMTP_STARTTLS=false
SMTP_USERNAME=
SMTP_PASSWORD=
SUPABASE_STORAGE_KEY=
CLAMAV_HOST=
CLAMAV_PORT=3310
CLAMAV_TLS=false
# Optional absolute CA path; empty uses system roots. Production remote scans require TLS.
CLAMAV_CA_FILE=
CLAMAV_TLS_SERVER_NAME=
REQUIRE_PRIVILEGED_MFA=false
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
# JSON mapping: installation ID -> explicitly authorized MESH organization UUID
GITHUB_INSTALLATIONS={}
GITHUB_WEBHOOK_SECRET=
GITHUB_WEBHOOK_PREVIOUS_SECRET=
# Organization UUID -> authorized analyst/senior developer UUID for optional push scans.
GITHUB_SCAN_ACTORS={}
SCANNER_IMAGE=mesh-scanner:local
DOCKER_EXECUTABLE=/usr/bin/docker
AI_PROVIDER=local
AI_MODEL=
AI_URL=
AI_API_KEY=
AI_ALLOW_EXTERNAL=false
# Organization UUID -> provider/model, monthly admission limits and optional trusted pricing.
AI_POLICIES={}
# JSON mapping: MESH organization UUID -> approved read-only AWS IAM role ARN
AWS_ROLE_BINDINGS={}
# Separate opt-in finance access; never inferred from posture bindings. No live billing fixture fallback.
AWS_BILLING_ROLE_BINDINGS={}
AWS_KEY_MAX_AGE_DAYS=90
# Organization UUID -> fixed HTTPS SCIM base URL and backend bearer token. Never expose to clients.
# require_version defaults true: providers must return ETag/meta.version for conditional PATCH.
# Set require_version=false only for an explicitly accepted unversioned provider; weaker race protection.
SCIM_BINDINGS={}
# Explicit organization UUID -> approved raw telemetry retention days (30–3650); empty disables retirement.
TELEMETRY_RETENTION_DAYS={}
# Independent Fernet key; generate securely with cryptography. OCR suggestions remain HR-reviewed.
DOCUMENT_OCR_ENABLED=false
DOCUMENT_OCR_KEY=
DOCUMENT_OCR_IMAGE=mesh-ocr:local
