# Preparation template only. Empty values deliberately prevent deployment.
# Put actual values in a protected file outside source/archives.
ENVIRONMENT=production
TEST_MODE=false
REQUIRE_PRIVILEGED_MFA=true
MESH_PUBLIC_URL=
MESH_BACKEND_IMAGE=
MESH_TRUSTED_PROXY_IPS=
DATABASE_URL=
REDIS_URL=
AUTH_RATE_SECRET=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_STORAGE_KEY=
CORS_ORIGINS=[]
INVITATION_BASE_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_ENCRYPTION_KEY=
# Use an actual authorized tenant before enabling a per-tenant worker profile.
WORKER_ORGANIZATION_ID=
# Fixed HTTPS SCIM authority per canonical organization UUID; defaults disabled.
SCIM_BINDINGS={}
CLAMAV_HOST=
CLAMAV_PORT=3310
CLAMAV_TLS=true
CLAMAV_CA_FILE=
CLAMAV_TLS_SERVER_NAME=
DOCUMENT_OCR_ENABLED=false
DOCUMENT_OCR_KEY=
DOCUMENT_OCR_IMAGE=
